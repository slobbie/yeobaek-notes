{
  "name": "yeobaek-notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @yeobaek/web",
    "dev:admin": "npm run dev --workspace @yeobaek/admin",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace @yeobaek/web",
    "start": "npm run start --workspace @yeobaek/web",
    "test": "node --test packages/content/tests/*.test.mjs apps/web/tests/*.test.mjs tests/*.test.mjs",
    "check:staged": "git diff --check --cached",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7"
  }
}
